# ─────────────────────────────────────────────────────────────────────────────
# PitchPulse 2026 — FIFA Stadium Intelligence & Accessible Wayfinding
# Environment Configuration Template
# Copy this file to .env and configure your secret credentials.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Primary Service: Google Gemini 2.5 Flash API Key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Operations Staff Token (Protects /api/stadium/incident dispatch)
STAFF_SECRET_TOKEN=CHANGE_ME_minimum_32_chars_random_secret

# Production Allowed Origin for CORS
ALLOWED_ORIGIN=http://localhost:8000

# Server Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
